        [Fact]
        public void UpdateEvent_ByDifferentOrganiser_ReturnsForbid()
        {
            // Arrange
            var db = GetDbContext();
            var controller = CreateController(db, 2); // User ID 2

            var organiser1 = new EventOrganiser { OrganiserID = 1, UserID = 1, User = new User() };
