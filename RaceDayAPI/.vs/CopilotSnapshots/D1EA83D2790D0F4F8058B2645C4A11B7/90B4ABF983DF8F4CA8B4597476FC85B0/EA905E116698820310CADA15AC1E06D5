        [Fact]
        public void DeleteEvent_WithValidId_ReturnsOkResult_AndRemovesFromDatabase()
        {
            // Arrange
            var db = GetDbContext();
            var controller = CreateController(db, 1);

            var organiser = new EventOrganiser { OrganiserID = 1, UserID = 1, User = new User() };
            db.EventOrganisers.Add(organiser);

            var eventToDelete = new Event
            {
                EventID = 1,
                OrganiserID = 1,
                EventName = "Event to Delete",
                Location = "Location",
                EventDate = DateTime.Now,
                Distance = 5.0m,
                EventType = "Walk",
                CreatedDate = DateTime.Now
            };
            db.Events.Add(eventToDelete);
            db.SaveChanges();

            // Act
            var result = controller.DeleteEvent(1);

            // Assert
            var okResult = Assert.IsType<OkObjectResult>(result);
            var message = okResult.Value;
            Assert.NotNull(message);

            // Verify deleted from database
            var eventFromDb = db.Events.FirstOrDefault(e => e.EventID == 1);
            Assert.Null(eventFromDb);
        }

        [Fact]
        public void DeleteEvent_WithInvalidId_ReturnsNotFound()
        {
