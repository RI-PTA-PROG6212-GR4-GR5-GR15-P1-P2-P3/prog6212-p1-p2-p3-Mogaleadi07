@model List<RaceDayMVC.Models.DTOs.EnrolmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="fw-bold mb-4">My Enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Event</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.EventName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="text-muted">You haven't enrolled in any events yet.</h5>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Browse Events</a>
            </div>
        }
    </div>
</div>