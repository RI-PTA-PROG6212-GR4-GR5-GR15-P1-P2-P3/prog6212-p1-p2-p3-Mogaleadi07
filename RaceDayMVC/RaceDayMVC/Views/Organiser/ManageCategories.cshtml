@model RaceDayMVC.Models.DTOs.EventDetailDto
@{
    ViewData["Title"] = "Manage Categories";
}

<h2 class="fw-bold mb-3">Categories for @Model.EventName</h2>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr><th class="ps-3">Category Name</th><th>Age Group</th><th>Distance</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@cat.CategoryName</td>
                                <td>@cat.AgeGroup</td>
                                <td>@cat.DistanceType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">Add New Category</div>
            <div class="card-body">
                <form asp-action="AddCategory" method="post">
                    <input type="hidden" name="eventId" value="@Model.EventID" />
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Age Group (Optional)</label>
                        <input name="AgeGroup" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance (Optional)</label>
                        <input name="DistanceType" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold">Add Category</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>
