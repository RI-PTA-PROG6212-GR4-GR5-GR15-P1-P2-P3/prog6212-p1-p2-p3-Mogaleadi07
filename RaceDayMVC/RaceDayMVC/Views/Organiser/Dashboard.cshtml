@model List<RaceDayMVC.Models.DTOs.EventSummaryDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-success fw-bold">+ Create New Event</a>
</div>

<div class="row">
    @if (Model.Any())
    {
        foreach (var ev in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="card-title text-primary fw-bold">@ev.EventName</h4>
                        <p class="text-muted mb-2">📍 @ev.Location | 📅 @ev.EventDate.ToString("dd MMM yyyy")</p>
                        <h5 class="mt-3">Total Enrolments: <span class="badge bg-info text-dark">@ev.TotalEnrolments</span></h5>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 d-flex gap-2">
                        <a asp-action="ManageCategories" asp-route-id="@ev.EventID" class="btn btn-outline-secondary w-50">Manage Categories</a>
                        <a asp-action="ViewEnrolments" asp-route-id="@ev.EventID" class="btn btn-outline-primary w-50">View Enrolments</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12"><div class="alert alert-info">You haven't created any events yet.</div></div>
    }
</div>